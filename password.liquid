<section class="g-hero">
  <div class="g-hero__inner">
    <img class="g-hero__crest" src="{{ 'gorony-mark-v2.png' | asset_url }}" alt="{{ shop.name }}">
    <h1>GORONY</h1>
    <p class="g-hero__sub">Opening soon.</p>
    {% form 'storefront_password' %}
      <input type="password" name="password" placeholder="Enter password" style="padding:12px 16px;background:transparent;color:var(--ivory);border:1px solid var(--bronze);margin-top:24px;">
      <button type="submit" class="g-btn-solid" style="margin-top:12px;">Enter</button>
    {% endform %}
  </div>
</section>
