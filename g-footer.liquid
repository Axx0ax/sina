        e.stopPropagation();
        var pages = Math.max(1, Math.ceil(mine().length / PAGE_SIZE));
        var next = page + step;
        if (next < 1 || next > pages) return;
        page = next;
        render();
        scrollUp();
      };
    }
    if (prevBtn) prevBtn.addEventListener('click', paginate(-1), true);
    if (nextBtn) nextBtn.addEventListener('click', paginate(1), true);

