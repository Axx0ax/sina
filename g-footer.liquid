    .g-srch-field{ margin-bottom:30px !important; }
    .g-srch-chip{ padding:9px 14px !important; letter-spacing:.16em !important; }
  }
  @media (prefers-reduced-motion:reduce){
    .g-srch-panel[data-open] .g-srch-field,
    .g-srch-panel[data-open] .g-srch-results,
    .g-srch-panel[data-open] .g-srch-foot{ animation:none !important; }
  }
</style>
