      BUY2SAVE50 -> BUY2SAVE40
  Append to the END of snippets/g-footer.liquid.
{%- endcomment -%}
<script>
(function () {
  var M = [['BUY1SAVE20', 'BUY1SAVE15'], ['BUY2SAVE50', 'BUY2SAVE40']];

  function fix() {
    var w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
      acceptNode: function (n) {
        var p = n.parentNode, t = p && p.nodeName;
        if (!p || t === 'SCRIPT' || t === 'STYLE' || t === 'NOSCRIPT') return NodeFilter.FILTER_REJECT;
        for (var i = 0; i < M.length; i++) {
          if (n.nodeValue && n.nodeValue.indexOf(M[i][0]) > -1) return NodeFilter.FILTER_ACCEPT;
        }
        return NodeFilter.FILTER_REJECT;
      }
    });
    var hits = [], n;
    while ((n = w.nextNode())) hits.push(n);
    hits.forEach(function (node) {
      var v = node.nodeValue;
      M.forEach(function (m) { v = v.split(m[0]).join(m[1]); });
      node.nodeValue = v;
    });
    M.forEach(function (m) {
      Array.prototype.forEach.call(document.querySelectorAll('[data-copy="' + m[0] + '"]'),
        function (e) { e.setAttribute('data-copy', m[1]); e.textContent = m[1]; });
      Array.prototype.forEach.call(document.querySelectorAll('a[href*="' + m[0] + '"]'),
        function (e) { e.setAttribute('href', e.getAttribute('href').split(m[0]).join(m[1])); });
    });
  }

  function go() {
    fix();
    try { new MutationObserver(fix).observe(document.body, { childList: true, subtree: true, characterData: true }); }
    catch (e) {}
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', go); else go();
})();
