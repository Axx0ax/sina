  GORONY - "Men" category pill.  v2
  End of snippets/g-footer.liquid, theme gorony-theme-fixed (160348602565).
{%- endcomment -%}
<script>
(function () {
  var SLUG = 'men';
  var LABEL = 'Men';
  var TYPE_MATCH = 'men';
  var PAGE_SIZE = 15;

  function slugify(s) {
    return String(s || '').toLowerCase().replace(/\s+/g, '');
  }

  function start() {
    var row = document.querySelector('.g-filter-pills');
    var grid = document.querySelector('.g-luxury-grid');
    if (!row || !grid) return;
    if (row.querySelector('[data-filter="' + SLUG + '"]')) return;

    fetch('/products.json?limit=250', { credentials: 'same-origin' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (data) {
        if (!data || !data.products) return;
        var types = {};
        data.products.forEach(function (p) { types[p.handle] = slugify(p.product_type); });
        tagCards(types);
      })
      .catch(function () {});

    function tagCards(types) {
      var cards = Array.prototype.slice.call(grid.querySelectorAll('.g-luxury-card'));
      var found = 0;

      cards.forEach(function (card) {
        var a = card.querySelector('a[href]');
        if (!a) return;
        var m = a.getAttribute('href').match(/\/products\/([^/?#]+)/);
        if (!m) return;
        if (types[m[1]] !== TYPE_MATCH) return;

        card.setAttribute('data-category', SLUG);
        found++;

        var eyebrow = card.querySelector('p.uppercase');
        if (eyebrow && !eyebrow.textContent.trim()) eyebrow.textContent = LABEL;
      });

      if (found) build(cards, found);
    }

    function build(cards, count) {
      var countEl = document.querySelector('[data-visible-count]');
      var pag = document.getElementById('gCatPagination');
      var prevBtn = document.getElementById('gCatPrevBtn');
      var nextBtn = document.getElementById('gCatNextBtn');
      var pageInfo = document.getElementById('gCatPageInfo');

      var pill = document.createElement('button');
      pill.type = 'button';
      pill.className = 'g-luxury-filter-pill';
      pill.setAttribute('data-filter', SLUG);
      pill.setAttribute('aria-pressed', 'false');
      pill.innerHTML = LABEL + ' <span class="g-pill-count">' + count + '</span>';
      row.appendChild(pill);

      var active = false;
      var page = 1;

      function allCards() {
        return Array.prototype.slice.call(grid.querySelectorAll('.g-luxury-card'));
      }
      function mine() {
        return allCards().filter(function (c) {
          return c.getAttribute('data-category') === SLUG;
        });
      }

      function render() {
        var men = mine();
        var total = men.length;
        var pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
        if (page > pages) page = pages;
        var from = (page - 1) * PAGE_SIZE;
        var to = from + PAGE_SIZE;

        allCards().forEach(function (card) {
          var i = men.indexOf(card);
          card.classList.toggle('g-card-hidden', !(i >= from && i < to));
        });

        if (countEl) countEl.textContent = total + (total === 1 ? ' Piece' : ' Pieces');

        Array.prototype.forEach.call(row.querySelectorAll('.g-luxury-filter-pill'), function (p) {
          var on = p === pill;
          p.classList.toggle('is-active', on);
          p.setAttribute('aria-pressed', on ? 'true' : 'false');
        });

        if (pag) {
          if (pages > 1) {
            pag.hidden = false;
            if (pageInfo) pageInfo.textContent = 'Page ' + page + ' of ' + pages;
            if (prevBtn) prevBtn.disabled = page <= 1;
            if (nextBtn) nextBtn.disabled = page >= pages;
          } else {
            pag.hidden = true;
          }
        }
      }

      function scrollUp() {
        var s = document.getElementById('g-collection-start');
        if (s) s.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      pill.addEventListener('click', function () {
        active = true;
        page = 1;
        render();
        scrollUp();
      });

      row.addEventListener('click', function (e) {
        var other = e.target.closest ? e.target.closest('.g-luxury-filter-pill') : null;
        if (!other || other === pill) return;
        active = false;
        pill.classList.remove('is-active');
        pill.setAttribute('aria-pressed', 'false');
      });

      function paginate(step) {
        return function (e) {
          if (!active) return;
          e.stopPropagation();
          var pages = Math.max(1, Math.ceil(mine().length / PAGE_SIZE));
          var next = page + step;
          if (next < 1 || next > pages) return;
          page = next;
          render();
          scrollUp();
        };
      }
      if (prevBtn) prevBtn.addEventListener('click', paginate(-1), true);
      if (nextBtn) nextBtn.addEventListener('click', paginate(1), true);

      var sortMenu = document.querySelector('[data-sort-menu]');
      if (sortMenu) {
        sortMenu.addEventListener('click', function () {
          if (!active) return;
          page = 1;
          setTimeout(render, 0);
        });
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }
})();
</script>
