<script>
(function () {
  var COPY = 'Join the house list for both welcome codes \u2014 15% off any single piece, or 40% off any two. Enter the code at checkout.';

  function fixOffer() {
    var sec = document.getElementById('join');
    if (!sec) return;
    var p = sec.querySelector('p.font-gorony-body') || sec.querySelector('p');
    if (p && p.textContent.trim() !== COPY) p.textContent = COPY;
  }

  function go() {
    fixOffer();
    try { new MutationObserver(fixOffer).observe(document.body, { childList: true, subtree: true }); }
    catch (e) {}
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', go); else go();
})();
</script>
