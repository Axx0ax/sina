  .g-srch-chip:hover{ background:#C9A24B !important; color:#0D1F18 !important; border-color:#C9A24B !important; }

  /* footer: two centred lines, clear hierarchy */
  .g-srch-foot{
    margin:34px 0 0 !important; padding:22px 0 0 !important;
    border-top:1px solid rgba(201,162,75,.16) !important;
    display:flex !important; flex-direction:column !important;
