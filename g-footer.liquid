</style>

<script>
(function () {
  var ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.8-3.8"></path></svg>';

  var panel = document.createElement('div');
  panel.className = 'g-srch-panel';
  panel.setAttribute('role', 'dialog');
  panel.setAttribute('aria-modal', 'true');
  panel.setAttribute('aria-label', 'Search products');
  panel.innerHTML =
    '<div class="g-srch-inner">' +
      '<div class="g-srch-head">' +
        '<span class="g-srch-eyebrow">Search the House</span>' +
        '<button type="button" class="g-srch-close" aria-label="Close search">Close</button>' +
      '</div>' +
      '<div class="g-srch-field">' + ICON +
        '<input class="g-srch-input" type="search" autocomplete="off" placeholder="What are you looking for?" aria-label="Search products">' +
      '</div>' +
      '<p class="g-srch-hint">Type to search</p>' +
      '<div class="g-srch-results"></div>' +
    '</div>';
  document.body.appendChild(panel);

  var input   = panel.querySelector('.g-srch-input');
  var results = panel.querySelector('.g-srch-results');
  var hint    = panel.querySelector('.g-srch-hint');
  var IDLE    = 'Type to search';

  function openPanel()  { panel.setAttribute('data-open', '1'); document.body.style.overflow = 'hidden'; setTimeout(function () { input.focus(); }, 60); }
  function closePanel() { panel.removeAttribute('data-open'); document.body.style.overflow = ''; input.value = ''; results.innerHTML = ''; hint.textContent = IDLE; }

  panel.querySelector('.g-srch-close').addEventListener('click', closePanel);
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closePanel(); });

  /* 1. the bar above the collection filters */
  var row = document.querySelector('.g-filter-row');
  if (row && row.parentNode) {
    var count = document.querySelectorAll('.g-luxury-card').length;
    var bar = document.createElement('button');
    bar.type = 'button';
    bar.className = 'g-srch-bar';
    bar.setAttribute('aria-label', 'Search products');
    bar.innerHTML = ICON + '<span>' + (count ? 'Search ' + count + ' products' : 'Search products') + '</span>';
    row.parentNode.insertBefore(bar, row);
    bar.addEventListener('click', openPanel);
  }

  /* 2. a Search item at the top of the mobile menu */
  var nav = document.getElementById('gMobileNav');
  if (nav) {
    var item = document.createElement('button');
    item.type = 'button';
    item.className = 'g-srch-navitem';
    item.innerHTML = ICON + '<span>Search</span>';
    nav.insertBefore(item, nav.firstChild);
    item.addEventListener('click', openPanel);
  }

  /* Shopify returns price as "35.99" on this endpoint, not cents - handle both */
  function priceOf(p) {
    if (p === undefined || p === null) return '';
    if (typeof p === 'number') return '$' + (p / 100).toFixed(2);
    var s = String(p).trim();
    return /^[0-9.]/.test(s) ? '$' + s : s;   /* already formatted? leave it */
  }
  function sized(u) { if (!u) return ''; return u.indexOf('?') > -1 ? u + '&width=160' : u + '?width=160'; }

  var timer = null, last = '';

  input.addEventListener('input', function () {
    var q = input.value.trim();
    clearTimeout(timer);
    if (q.length < 2) { results.innerHTML = ''; hint.textContent = IDLE; return; }
    hint.textContent = 'Searching';
    timer = setTimeout(function () { run(q); }, 260);
  });

  input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && input.value.trim()) {
      window.location.href = '/search?q=' + encodeURIComponent(input.value.trim()) + '&type=product';
    }
  });

  function run(q) {
    last = q;
    fetch('/search/suggest.json?q=' + encodeURIComponent(q) +
          '&resources[type]=product&resources[limit]=8&resources[options][unavailable_products]=last')
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (data) {
        if (!data || q !== last) return;
        var list = (data.resources && data.resources.results && data.resources.results.products) || [];
        if (!list.length) { results.innerHTML = ''; hint.textContent = 'No match for "' + q + '"'; return; }
        hint.textContent = list.length + (list.length === 1 ? ' result' : ' results');
        results.innerHTML = list.map(function (p) {
          var img = sized((p.featured_image && p.featured_image.url) || p.image || '');
          var cat = p.type || '';
          var pr  = priceOf(p.price);
          return '<a class="g-srch-item" href="' + p.url + '">' +
                   (img ? '<img src="' + img + '" alt="" loading="lazy">' : '') +
                   '<span>' +
                     (cat ? '<span class="g-srch-cat">' + cat + '</span>' : '') +
                     '<span class="g-srch-name">' + p.title + '</span>' +
                     (pr ? '<span class="g-srch-price">' + pr + '</span>' : '') +
                   '</span>' +
                 '</a>';
        }).join('') +
        '<a class="g-srch-all" href="/search?q=' + encodeURIComponent(q) + '&type=product">See all results</a>';
      })
      .catch(function () { hint.textContent = 'Search unavailable'; });
  }
})();
</script>
{%- comment -%}
  GORONY - finishing details (31 Aug 2026)
  No product names or copy are changed anywhere.

  1. Centerpiece button now goes to the serum it advertises, not to the
     full 76-product list. Text becomes "Shop the Serum".
  2. Images fade in instead of popping. Kills the blank-box flash on the
     product page thumbnails and the collection grid.
  3. Product page thumbnails sit on a deep green tile while loading, so an
     empty box never shows white.
  4. Buttons, shade swatches and the search bar give a small press response.

  Safe by design: if the JavaScript fails, images are visible as normal and
  nothing is hidden. Everything below is additive.
{%- endcomment -%}

<style>
  /* images fade in rather than snapping into place */
  .g-fade-in{opacity:0;transition:opacity .55s ease;}
  .g-fade-in.g-loaded{opacity:1;}

  /* product page thumbnails: deep green tile, never a white flash */
  .g-pdp__thumb{background:#0F241C;}
  .g-pdp__thumb img{transition:opacity .4s ease;}

  /* gentle press feedback - makes taps feel considered */
  .g-luxury-card > a{transition:border-color .3s ease, transform .3s ease;}
  .g-luxury-card > a:active{transform:scale(.985);}
  .g-btn-solid,.g-swatch,.g-srch-bar{transition:transform .12s ease, background .25s ease, border-color .25s ease;}
  .g-btn-solid:active,.g-swatch:active,.g-srch-bar:active{transform:translateY(1px);}

  /* keeps the carousel and card zoom crisp on mobile */
  .g-carousel-slide img,.g-luxury-card img{backface-visibility:hidden;}
</style>

<script>
(function () {
  /* 1. point the Centerpiece button at the product it advertises */
  var links = document.querySelectorAll('a[href="/collections/all"]');
  for (var i = 0; i < links.length; i++) {
    var a = links[i];
    if (/discover the collection/i.test(a.textContent || '')) {
      a.setAttribute('href', '/products/collagen-and-retinol-serum');
      a.textContent = 'Shop the Serum';
      break;
    }
  }

  /* 2. fade images in. Only touches images that have not loaded yet, so a
        failure here can never leave a picture hidden. */
  function fade(img) {
    if (img.complete) return;
    img.classList.add('g-fade-in');
    function show() { img.classList.add('g-loaded'); }
    img.addEventListener('load', show, { once: true });
    img.addEventListener('error', show, { once: true });
    /* belt and braces - reveal after 3s no matter what */
    setTimeout(show, 3000);
  }

  function sweep() {
    var imgs = document.querySelectorAll('img:not(.g-fade-in)');
    for (var i = 0; i < imgs.length; i++) fade(imgs[i]);
  }

  sweep();

  /* catch images added later, e.g. search results and the carousel */
  if (window.MutationObserver) {
    var mo = new MutationObserver(function () { sweep(); });
    mo.observe(document.body, { childList: true, subtree: true });
  }
})();
</script>
{%- comment -%}
  GORONY - search panel polish (31 Aug 2026)

  Add-on for the existing search. Nothing to delete.

  Before: opening search gave a huge empty green void with the words
