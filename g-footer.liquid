{%- comment -%}
  GORONY - restate the founding offers:
      Buy 1  20% -> 15%   (code BUY1SAVE20)
      Buy 2  50% -> 40%   (code BUY2SAVE50)
  Append to the END of snippets/g-footer.liquid.
  Change BOTH Shopify discounts first - this only changes what customers read.
{%- endcomment -%}
<script>
(function () {
  var CODES = [
    ['BUY1SAVE20', 'BUY1SAVE20'],   // [current, new] - differ only after creating the new one
    ['BUY2SAVE50', 'BUY2SAVE50']
  ];

  var PHRASES = [
    ['Get 50% Off',   'Get 40% Off'],
    ['get 50% off',   'get 40% off'],
    ['up to 50% off', 'up to 40% off'],
    ['Get 20% Off',   'Get 15% Off'],
    ['get 20% off',   'get 15% off']
  ];

  function swap(s) {
    var i;
    for (i = 0; i < PHRASES.length; i++) s = s.split(PHRASES[i][0]).join(PHRASES[i][1]);
    for (i = 0; i < CODES.length; i++) {
      if (CODES[i][0] !== CODES[i][1]) s = s.split(CODES[i][0]).join(CODES[i][1]);
    }
    return s;
  }

  function run() {
    var walk = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
      acceptNode: function (n) {
        var p = n.parentNode;
        if (!p) return NodeFilter.FILTER_REJECT;
        var t = p.nodeName;
        if (t === 'SCRIPT' || t === 'STYLE' || t === 'NOSCRIPT') return NodeFilter.FILTER_REJECT;
        return n.nodeValue && n.nodeValue.indexOf('%') > -1
          ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
      }
    });
    var hits = [], n;
    while ((n = walk.nextNode())) hits.push(n);
    hits.forEach(function (node) {
      var out = swap(node.nodeValue);
      if (out !== node.nodeValue) node.nodeValue = out;
    });

    CODES.forEach(function (pair) {
      if (pair[0] === pair[1]) return;
      Array.prototype.forEach.call(
        document.querySelectorAll('[data-copy="' + pair[0] + '"]'),
        function (el) { el.setAttribute('data-copy', pair[1]); el.textContent = pair[1]; });
      Array.prototype.forEach.call(
        document.querySelectorAll('a[href*="' + pair[0] + '"]'),
        function (el) { el.setAttribute('href', el.getAttribute('href').split(pair[0]).join(pair[1])); });
    });
  }

  function start() {
    run();
    try {
      new MutationObserver(function () { run(); })
        .observe(document.body, { childList: true, subtree: true, characterData: true });
    } catch (e) {}
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }
})();
</script>
{%- comment -%}
  GORONY - point the advertised codes at the renamed Shopify discounts.
