    transition:background .2s,border-color .2s,color .2s;}
  .g-srch-chip:active{background:#C9A24B;border-color:#C9A24B;color:#0D1F18!important;}
  .g-srch-foot{margin-top:26px;padding-top:18px;border-top:1px solid rgba(139,111,62,0.25);}
  .g-srch-foot a{display:block;font-family:Jost,Arial,sans-serif!important;font-size:11px!important;
    letter-spacing:.2em!important;text-transform:uppercase;color:#C9A24B!important;text-decoration:none;padding:7px 0;}
</style>

<script>
(function () {
  /* every term below was checked against this store - all return products */
  var TERMS = ['Lipstick','Lip Gloss','Serum','Moisturizer','Mascara','Eyeliner','Brush','Hair Oil'];

  function start() {
    var panel = document.querySelector('.g-srch-panel');
    if (!panel) return false;
    var results = panel.querySelector('.g-srch-results');
    var input   = panel.querySelector('.g-srch-input');
    var hint    = panel.querySelector('.g-srch-hint');
    if (!results || !input) return false;

    var busy = false;

    function showSuggestions() {
      if (busy) return;
      busy = true;
      if (hint) hint.style.display = 'none';

      var html = '<div class="g-srch-sugg"><p class="g-srch-sugg-label">Popular searches</p><div class="g-srch-chips">';
      for (var i = 0; i < TERMS.length; i++) {
        html += '<button type="button" class="g-srch-chip">' + TERMS[i] + '</button>';
      }
      html += '</div><div class="g-srch-foot">' +
                '<a href="/collections/all">Browse the full collection</a>' +
                '<a href="/products/collagen-and-retinol-serum">The Centerpiece &mdash; Collagen &amp; Retinol Serum</a>' +
              '</div></div>';
      results.innerHTML = html;

      var chips = results.querySelectorAll('.g-srch-chip');
      for (var j = 0; j < chips.length; j++) {
        chips[j].addEventListener('click', function () {
          input.value = this.textContent;
          input.dispatchEvent(new Event('input', { bubbles: true }));
          input.focus();
        });
      }
      busy = false;
    }

    function refresh() {
      var typing = input.value.trim().length >= 2;
      var hasResults = !!results.querySelector('.g-srch-item');
      var hasSuggestions = !!results.querySelector('.g-srch-sugg');

      if (typing) {
        if (hint) hint.style.display = '';
        return;
      }
      if (!hasResults && !hasSuggestions) showSuggestions();
    }

    /* the panel clears its own results on open and on close - catch that */
    if (window.MutationObserver) {
      new MutationObserver(function () { refresh(); })
        .observe(results, { childList: true });
      new MutationObserver(function () { setTimeout(refresh, 40); })
        .observe(panel, { attributes: true, attributeFilter: ['data-open'] });
    }
    input.addEventListener('input', refresh);
    refresh();
    return true;
  }

  if (!start()) {
    var n = 0;
    var t = setInterval(function () { if (start() || ++n > 20) clearInterval(t); }, 400);
  }
})();
</script>
