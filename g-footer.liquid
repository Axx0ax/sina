<script>
(()=>{function bindVideos(scope){scope.querySelectorAll('video').forEach(video=>{if(video.dataset.goronyLoop)return;video.dataset.goronyLoop='true';video.muted=true;video.defaultMuted=true;video.loop=true;video.autoplay=true;video.playsInline=true;video.controls=false;video.setAttribute('muted','');video.setAttribute('autoplay','');video.setAttribute('loop','');video.setAttribute('playsinline','');video.removeAttribute('controls');function play(){if(!document.hidden&&video.paused)video.play().catch(()=>{});}video.addEventListener('pause',play);video.addEventListener('canplay',play);document.addEventListener('visibilitychange',play);play();});}function start(){bindVideos(document);}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});else start();document.addEventListener('shopify:section:load',event=>bindVideos(event.target));})();
</script>

{% doc %}Remove decorative arrow glyphs from storefront navigation and calls to action.{% enddoc %}
<style>
.gf-arrow,.gf-credit-arrow,.gh-arrow,.gh-flower,.ga-product-arrow{display:none!important}
.gf-discover{display:inline-block;border-bottom:1px solid #c9b47f80;padding-bottom:12px;transition:color .3s,border-color .3s}.gf-discover:hover{color:#e8d7ac;border-color:#e8d7ac}
