  }
  .g-srch-foot a:hover{ color:#F3DCA0 !important; }
  .g-srch-foot a:last-child{ color:rgba(245,240,230,.62) !important; font-size:9.5px !important; }
  .g-srch-foot a:last-child:hover{ color:#C9A24B !important; }

  /* entrance */
  @keyframes gSrchRise{ from{opacity:0; transform:translateY(14px)} to{opacity:1; transform:none} }
  .g-srch-panel[data-open] .g-srch-field,
  .g-srch-panel[data-open] .g-srch-results,
  .g-srch-panel[data-open] .g-srch-foot{ animation:gSrchRise .6s cubic-bezier(.2,.7,.3,1) both; }
  .g-srch-panel[data-open] .g-srch-results{ animation-delay:.07s; }
  .g-srch-panel[data-open] .g-srch-foot{ animation-delay:.13s; }

  /* phones */
  @media (max-width:640px){
    .g-srch-input{ font-size:22px !important; }
