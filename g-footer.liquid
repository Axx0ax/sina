.gf-top span:empty,.gx-product>div>span:empty{display:none!important}
.gh-invitation{justify-content:flex-start!important}
</style>
<script>
(()=>{const arrows=/[\u2190-\u2199\u219D\u21A0\u21AA\u21B1\u21D2\u2794\u279C\u27A1\u2B06\u2B07\uFE0E\uFE0F]/g;function clean(scope){if(!scope.querySelectorAll)return;scope.querySelectorAll('a,button,summary').forEach(control=>{if(control.closest('.jdgm-widget'))return;const walker=document.createTreeWalker(control,NodeFilter.SHOW_TEXT);let node,hadArrow=false;while(node=walker.nextNode()){if(node.parentElement.closest('script,style,svg,textarea,[contenteditable="true"]'))continue;const text=node.data.replace(arrows,'');if(text!==node.data){hadArrow=true;node.data=text;}}if(hadArrow&&!control.textContent.trim()&&!control.querySelector('svg,img,input')){const label=control.getAttribute('aria-label');if(label)control.append(document.createTextNode(/search/i.test(label)?'Search':label));}});const search=scope.querySelector('.gh-search button');if(search&&!search.textContent.trim())search.textContent='Search';}function start(){clean(document);const observer=new MutationObserver(records=>records.forEach(record=>record.addedNodes.forEach(node=>{if(node.nodeType===1)clean(node.parentElement||node)})));observer.observe(document.body,{childList:true,subtree:true});}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});else start();})();
</script>
