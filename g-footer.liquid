{% doc %}
  Shared Gorony footer with motion-aware interactions and agency attribution.
{% enddoc %}
{% # theme-check-disable MissingAsset %}
<footer class="gf" data-gorony-footer>
  <div class="gf-aura" aria-hidden="true"></div>
  <div class="gf-inner">
    <div class="gf-invitation"><div><p class="gf-label">The house of Gorony</p><h2>Make room for<br><em>something beautiful.</em></h2></div><a class="gf-discover" href="{{ routes.all_products_collection_url }}"><span class="gf-arrow" aria-hidden="true">↗</span><span>Explore the collection</span></a></div>
    <div class="gf-columns"><div class="gf-house"><a class="gf-brand" href="{{ routes.root_url }}"><img src="{{ 'gorony-mark-v2.png' | asset_url }}" width="64" height="64" alt="Gorony home"><span>GORONY</span></a><p>Facial skincare and makeup from a family-founded house.<br>Crafted for her.</p><span class="gf-est">Founded by Sina Gorony · Est. 2026</span></div>
      <nav aria-label="Explore Gorony"><h3 class="gf-label">Explore</h3><a href="{{ routes.all_products_collection_url }}">The collection</a><a href="/pages/our-story">Our story</a><a href="/pages/faq">Frequently asked questions</a></nav>
      <nav aria-label="Gorony customer care"><h3 class="gf-label">Here for you</h3><a href="/pages/contact">Contact the house</a>{% if shop.shipping_policy != blank %}<a href="{{ shop.shipping_policy.url }}">Shipping</a>{% endif %}{% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">Returns &amp; refunds</a>{% endif %}</nav>
    </div>
    <div class="gf-signature" aria-hidden="true"><span>GORONY</span><img class="gf-signature-crest" src="{{ 'gorony-mark-v2.png' | asset_url }}" width="130" height="130" alt=""></div>
    <div class="gf-bottom"><p>© {{ 'now' | date: '%Y' }} Gorony. All rights reserved.</p><nav aria-label="Store policies">{% if shop.privacy_policy != blank %}<a href="{{ shop.privacy_policy.url }}">Privacy</a>{% endif %}{% if shop.terms_of_service != blank %}<a href="{{ shop.terms_of_service.url }}">Terms</a>{% endif %}</nav><a class="gf-credit" href="https://www.axiomagecny.com/" target="_blank" rel="noopener noreferrer" aria-label="Made by AXIOM agency, opens in a new tab"><span>Made by</span> <strong>AXIOM</strong><span class="gf-credit-arrow" aria-hidden="true">↗</span></a><button class="gf-top" type="button">Back to top <span aria-hidden="true">↑</span></button></div>
  </div>
</footer>
{% stylesheet %}
.gf{position:relative;isolation:isolate;overflow:hidden;background:#0d211a;color:#f3efe6;padding:80px 0 26px;font-family:Arial,sans-serif;border-top:1px solid #b99a5c55}.gf *{box-sizing:border-box}.gf a{color:inherit;text-decoration:none}.gf h2,.gf h3,.gf p{margin:0}.gf-inner{position:relative;z-index:1;width:88%;max-width:1400px;margin:auto}.gf-aura{position:absolute;z-index:0;inset:0;pointer-events:none;background:radial-gradient(ellipse at var(--gf-x,80%) var(--gf-y,20%),#bd9d5030,transparent 55%);opacity:.75}.gf-invitation{display:flex;align-items:center;justify-content:space-between;gap:40px;padding-bottom:65px;border-bottom:1px solid #c9a24b35}.gf-label{font-size:10px!important;font-weight:400;letter-spacing:.2em;text-transform:uppercase;color:#c9b47f;line-height:1.7}.gf h2{font-family:Georgia,serif;font-weight:400;font-size:clamp(36px,4.8vw,74px);line-height:1.1;letter-spacing:-.04em;margin-top:24px}.gf h2 em{color:#c9b47f;font-weight:400}.gf-discover{display:flex;align-items:center;flex-direction:column;gap:20px;font-size:9px;letter-spacing:.16em;text-transform:uppercase;flex-shrink:0}.gf-arrow{display:grid;place-items:center;width:110px;height:110px;border-radius:50%;border:1px solid #c9b47f80;font-size:46px;font-weight:300;transition:transform .6s,background .4s,color .4s}.gf-discover:hover .gf-arrow{transform:rotate(45deg);background:#c9b47f;color:#0d211a}.gf-columns{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:60px;padding:60px 0}.gf-brand{display:inline-flex;gap:15px;align-items:center;color:#c9b47f!important;font-family:Georgia,serif;font-size:22px;letter-spacing:.2em}.gf-brand img{object-fit:contain;width:55px;height:55px}.gf-house p{font-size:13px;line-height:1.9;max-width:300px;color:#c0c7bd;margin:20px 0}.gf-est{font-size:10px;letter-spacing:.04em;color:#b7bbac}.gf-columns nav{display:flex;align-items:flex-start;flex-direction:column;gap:15px}.gf-columns nav h3{margin-bottom:10px}.gf-columns nav a{font-size:13px;color:#d2d7cd}.gf nav a{position:relative;padding-bottom:4px;transition:color .3s}.gf nav a:after{content:'';position:absolute;left:0;bottom:0;width:100%;height:1px;background:#c9b47f;transform:scaleX(0);transform-origin:left;transition:transform .4s}.gf nav a:hover{color:#e5c888}.gf nav a:hover:after{transform:scaleX(1)}.gf-signature{display:flex;align-items:center;justify-content:space-between;gap:30px;border-bottom:1px solid #c9a24b35;padding:10px 0 30px;color:#c9b47f}.gf-signature>span{font-family:Georgia,serif;font-size:clamp(60px,14.4vw,230px);line-height:1;letter-spacing:.07em;background:linear-gradient(110deg,#8c784d 10%,#e2ce9b 42%,#b29965 70%);background-clip:text;-webkit-background-clip:text;color:transparent}.gf-signature svg{width:clamp(60px,10vw,155px);flex-shrink:0;stroke:#c9b47f;stroke-width:.65;transition:transform 1.5s}.gf-signature:hover svg{transform:rotate(60deg)}.gf-bottom{display:flex;justify-content:space-between;align-items:center;gap:24px;padding-top:26px;flex-wrap:wrap;font-size:10px;color:#bec5b9}.gf-bottom nav{display:flex;gap:20px}.gf-credit{display:inline-flex;align-items:center;gap:8px;padding:9px 13px;border:1px solid #c9a24b40;border-radius:30px;transition:background .3s,border-color .3s}.gf-credit strong{font-size:11px;letter-spacing:.13em;color:#ddc488;font-weight:500}.gf-credit-arrow{display:inline-block;transition:transform .3s}.gf-credit:hover{background:#c9a24b15;border-color:#c9a24b}.gf-credit:hover .gf-credit-arrow{transform:translate(2px,-2px)}.gf-top{border:0;background:none;color:#d5c08a;font:inherit;cursor:pointer;padding:10px 0}.gf-top span{display:inline-block;margin-left:9px;transition:transform .3s}.gf-top:hover span{transform:translateY(-4px)}.gf a:focus-visible,.gf button:focus-visible{outline:2px solid #e2ce9b;outline-offset:6px}.gf.gf-animated .gf-invitation,.gf.gf-animated .gf-columns,.gf.gf-animated .gf-signature{transition:opacity .9s,transform .9s}.gf.gf-animated.gf-waiting .gf-invitation,.gf.gf-animated.gf-waiting .gf-columns,.gf.gf-animated.gf-waiting .gf-signature{opacity:0;transform:translateY(22px)}.gf.gf-animated .gf-columns{transition-delay:.1s}.gf.gf-animated .gf-signature{transition-delay:.2s}
@media(max-width:760px){.gf{padding-top:55px}.gf-invitation{align-items:flex-start;flex-direction:column;gap:30px;padding-bottom:40px}.gf-discover{flex-direction:row;gap:20px}.gf-arrow{width:65px;height:65px;font-size:32px}.gf-columns{grid-template-columns:1fr 1fr;gap:35px 20px;padding:40px 0}.gf-house{grid-column:1/-1}.gf-signature{gap:10px;padding-bottom:24px}.gf-signature>span{font-size:13vw;letter-spacing:.025em}.gf-signature svg{width:50px}.gf-bottom{gap:22px;font-size:10px}.gf-bottom>p{width:100%}.gf-credit{margin-left:auto}.gf-top{width:100%;text-align:left}.gf-columns nav a{font-size:12px;line-height:1.6}}
@media(prefers-reduced-motion:reduce){.gf *{transition:none!important;animation:none!important}.gf.gf-animated.gf-waiting .gf-invitation,.gf.gf-animated.gf-waiting .gf-columns,.gf.gf-animated.gf-waiting .gf-signature{opacity:1;transform:none}}
{% endstylesheet %}
{% javascript %}
(()=>{document.querySelectorAll('[data-gorony-footer]').forEach(footer=>{if(footer.dataset.ready)return;footer.dataset.ready='true';const reduced=matchMedia('(prefers-reduced-motion: reduce)');if(!reduced.matches&&'IntersectionObserver'in window){footer.classList.add('gf-animated','gf-waiting');const observer=new IntersectionObserver(entries=>{if(entries.some(e=>e.isIntersecting)){footer.classList.remove('gf-waiting');observer.disconnect();}},{threshold:.08});observer.observe(footer);}let frame=0;footer.addEventListener('pointermove',e=>{if(reduced.matches||e.pointerType!=='mouse'||frame)return;frame=requestAnimationFrame(()=>{const r=footer.getBoundingClientRect();footer.style.setProperty('--gf-x',((e.clientX-r.left)/r.width*100)+'%');footer.style.setProperty('--gf-y',((e.clientY-r.top)/r.height*100)+'%');frame=0;});},{passive:true});footer.querySelector('.gf-top').addEventListener('click',()=>{window.scrollTo({top:0,behavior:reduced.matches?'instant':'smooth'});const brand=document.querySelector('header a[href="/"]');if(brand)brand.focus({preventScroll:true});});});})();
{% endjavascript %}


{%- comment -%}
  GORONY — tapping a photo also picks that shade (added 28 Aug 2026)
  Runs on every page but exits instantly unless the page is a product
  with a shade list. Nothing here changes how the shade buttons behave.
{%- endcomment -%}

<script>
(function () {
  var thumbs = document.querySelectorAll('[data-thumb]');
  if (!thumbs.length) return;

  var form = document.getElementById('gProductForm');
  if (!form) return;

  var group = form.querySelector('[data-option-group]');
  if (!group) return; /* product has no shades - nothing to sync */

  /* reduce any image URL to just its filename, so the two formats match */
  function fileKey(url) {
    if (!url) return '';
    try { url = new URL(url, window.location.href).pathname; } catch (e) {}
    return url.split('/').pop().split('?')[0].toLowerCase();
  }

  var handle = (window.location.pathname.split('/products/')[1] || '')
                 .split('?')[0].replace(/\/$/, '');
  if (!handle) return;

  var photoToShade = null;

  fetch('/products/' + handle + '.js', { headers: { Accept: 'application/json' } })
    .then(function (r) { return r.ok ? r.json() : null; })
    .then(function (product) {
      if (!product || !product.variants) return;
      photoToShade = {};
      product.variants.forEach(function (v) {
        if (v.featured_image && v.featured_image.src) {
          photoToShade[fileKey(v.featured_image.src)] = v.option1;
        }
      });
      /* tell screen readers the thumbnail is a shade, not just "image 3" */
      thumbs.forEach(function (t) {
        var shade = photoToShade[fileKey(t.getAttribute('data-full'))];
        if (shade) t.setAttribute('aria-label', 'Show ' + shade);
      });
    })
    .catch(function () { /* blocked or offline - thumbnails work as before */ });

  document.addEventListener('click', function (e) {
    if (!photoToShade || !e.target.closest) return;

    var thumb = e.target.closest('[data-thumb]');
    if (!thumb) return;

    var shade = photoToShade[fileKey(thumb.getAttribute('data-full'))];
    if (!shade) return; /* an extra photo, not a shade - leave it alone */

    var swatch = null;
    group.querySelectorAll('[data-swatch]').forEach(function (s) {
      if (s.getAttribute('data-value') === shade) swatch = s;
    });
    if (!swatch || swatch.classList.contains('g-swatch--active')) return;

    /* stop the theme's picture-only handler, then let the theme's own
       shade handler do everything: shade, price, variant, picture, URL */
    e.stopPropagation();
    swatch.click();
  }, true);
})();
</script>

<style>
  .g-srch-bar{display:flex!important;align-items:center;gap:11px;width:100%;margin:0 0 20px!important;padding:14px 20px!important;background:rgba(245,240,230,0.04);border:1px solid rgba(201,162,75,0.42);border-radius:999px;cursor:text;text-align:left;}
  .g-srch-bar svg{width:17px!important;height:17px!important;color:#C9A24B;flex:0 0 auto;}
  .g-srch-bar span{font-family:Jost,Arial,sans-serif!important;font-size:12px!important;letter-spacing:.18em!important;text-transform:uppercase;color:rgba(245,240,230,0.5)!important;}
  .g-srch-navitem{display:flex!important;align-items:center;gap:10px;padding:12px 0!important;font-family:Jost,Arial,sans-serif!important;font-size:12px!important;letter-spacing:.2em!important;text-transform:uppercase;color:#C9A24B!important;background:none;border:0;width:100%;text-align:left;cursor:pointer;}
  .g-srch-navitem svg{width:15px!important;height:15px!important;}
  .g-srch-panel{position:fixed;inset:0;z-index:60;display:none;background:#0D1F18;}
  .g-srch-panel[data-open="1"]{display:block;}
  .g-srch-inner{max-width:720px;margin:0 auto;padding:22px 22px 32px;height:100%;display:flex;flex-direction:column;}
  .g-srch-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:18px;}
  .g-srch-eyebrow{font-family:Jost,Arial,sans-serif!important;font-size:10px!important;letter-spacing:.34em!important;text-transform:uppercase;color:#8B6F3E!important;}
  .g-srch-close{background:none;border:0;color:#C9A24B!important;cursor:pointer;font-size:11px!important;letter-spacing:.22em!important;text-transform:uppercase;font-family:Jost,Arial,sans-serif!important;padding:8px 0 8px 16px;line-height:1!important;}
  .g-srch-field{display:flex;align-items:center;gap:12px;border-bottom:1px solid rgba(201,162,75,0.5);padding-bottom:12px;}
  .g-srch-field svg{width:20px!important;height:20px!important;color:#C9A24B;flex:0 0 auto;}
  .g-srch-input{flex:1;background:transparent;border:0;color:#F5F0E6!important;font-family:"Playfair Display",Georgia,serif!important;font-size:25px!important;padding:2px 0;outline:none;}
  .g-srch-input::placeholder{color:rgba(245,240,230,0.28)!important;}
  .g-srch-hint{font-family:Jost,Arial,sans-serif!important;font-size:10px!important;letter-spacing:.26em!important;text-transform:uppercase;color:rgba(245,240,230,0.4)!important;margin:18px 0 4px!important;}
  .g-srch-results{overflow-y:auto;flex:1;-webkit-overflow-scrolling:touch;}
