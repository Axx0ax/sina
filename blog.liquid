<section class="g-section" style="padding-top:140px;">
  <div class="g-wrap g-narrow">
    <h1 class="g-h2">{{ blog.title }}</h1>
    {%- for article in blog.articles -%}
      <a href="{{ article.url }}" style="display:block;padding:24px 0;border-bottom:1px solid rgba(139,111,62,0.3);">
        <p class="g-display" style="color:var(--gold);font-size:22px;margin:0;">{{ article.title }}</p>
        <p style="color:rgba(245,240,230,0.6);font-size:14px;margin:8px 0 0;">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
      </a>
    {%- endfor -%}
  </div>
</section>
