{% # theme-check-disable MissingAsset %}
{% liquid
  assign selection = collections.all
  if section.settings.featured_collection != blank
    assign selection = section.settings.featured_collection
  endif
  assign centerpiece = all_products['collagen-and-retinol-serum']
  if centerpiece == blank
    assign centerpiece = selection.products.first
  endif
%}
<div class="ga" data-atelier>
  <section class="ga-hero">
    <div class="ga-hero-copy ga-reveal">
      <p class="ga-kicker">The house of Gorony · Est. 2026</p>
      <h1>Beauty,<br>with a little<br><em>more soul.</em></h1>
      <p class="ga-intro">Considered skincare. Expressive makeup.<br>A family-founded house, crafted for her.</p>
      <a class="ga-button" href="{{ routes.all_products_collection_url }}">Explore the collection <span aria-hidden="true">↗</span></a>
      <div class="ga-hero-foot"><span>Skincare &amp; makeup</span><a href="#ga-selection">Discover the house ↓</a></div>
    </div>
    <div class="ga-hero-film">
      <video class="ga-video" muted loop playsinline autoplay preload="metadata" aria-label="Emerald silk in motion"><source src="{{ 'silk-drift.mp4' | asset_url }}" type="video/mp4"></video>
      <div class="ga-film-title"><img src="{{ 'gorony-mark-v2.png' | asset_url }}" width="110" height="110" alt="Gorony family crest"><span>GORONY</span><i>Crafted for Her.</i></div>
      <div class="ga-film-foot"><span>A moment, just for you.</span><button class="ga-motion" type="button" aria-pressed="false">Pause motion</button></div>
    </div>
  </section>
  <section class="ga-selection ga-wrap" id="ga-selection">
    <div class="ga-heading ga-reveal"><div><p class="ga-kicker">The edit / 01</p><h2>Your everyday.<br><em>Beautifully considered.</em></h2></div><a class="ga-link" href="{{ routes.all_products_collection_url }}">Shop all pieces ↗</a></div>
    <div class="ga-products">
      {% for product in selection.products limit: 4 %}
        <a class="ga-product ga-reveal" href="{{ product.url }}">
          <div class="ga-product-image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: widths: '320, 480, 640, 900', sizes: '(max-width: 700px) 45vw, 23vw', loading: 'lazy', alt: product.title }}{% endif %}<span class="ga-product-arrow" aria-hidden="true">↗</span></div>
          <p class="ga-kicker">{{ product.type | default: 'The collection' | escape }}</p><div class="ga-product-caption"><h3>{{ product.title | escape }}</h3><span>{{ product.price | money }}</span></div>
        </a>
      {% else %}<p>Discover the latest pieces in our collection.</p>{% endfor %}
    </div>
  </section>
  <section class="ga-story"><div class="ga-wrap ga-reveal"><p class="ga-kicker">A family. A feeling. A house.</p><h2>Not just a routine.<br><em>A moment of your own.</em></h2><p>Gorony brings skincare and makeup into the same thoughtful world. Pieces to reach for, rituals to return to, and beauty that feels like you.</p><a class="ga-link" href="/pages/our-story">Inside the house ↗</a></div><span class="ga-orbit" aria-hidden="true"></span></section>
  <section class="ga-cinema" aria-label="The Gorony film"><div class="ga-cinema-scene"><video class="ga-video" muted loop playsinline autoplay preload="none" aria-label="Golden beauty film"><source src="{{ 'aurum-film.mp4' | asset_url }}" type="video/mp4"></video><div class="ga-cinema-copy"><p class="ga-kicker">Light. Texture. Ritual.</p><h2>A slower moment.<br><em>A lasting impression.</em></h2><a class="ga-link" href="{{ routes.all_products_collection_url }}">Find your next essential ↗</a></div><span class="ga-cinema-index" aria-hidden="true">THE HOUSE / IN MOTION</span></div></section>
  {% if centerpiece != blank %}<section class="ga-feature ga-wrap"><a class="ga-feature-image ga-reveal" href="{{ centerpiece.url }}">{% if centerpiece.featured_image %}{{ centerpiece.featured_image | image_url: width: 1200 | image_tag: widths: '400, 600, 900, 1200', sizes: '(max-width: 700px) 90vw, 45vw', loading: 'lazy', alt: centerpiece.title }}{% endif %}</a><div class="ga-feature-copy ga-reveal"><p class="ga-kicker">In focus / 02</p><h2>A place in<br><em>your ritual.</em></h2><h3>{{ centerpiece.title | escape }}</h3><p>Discover the formula, explore the details, and make room for a little everyday care.</p><span class="ga-price">{{ centerpiece.price | money }}</span><a class="ga-button" href="{{ centerpiece.url }}">Discover this piece <span aria-hidden="true">↗</span></a></div></section>{% endif %}
  <section class="ga-join" id="ga-join"><div class="ga-wrap ga-reveal"><p class="ga-kicker">An invitation from Gorony</p><h2>A little closer<br><em>to the house.</em></h2><p>New pieces, private offers, and the occasional letter.<br>Thoughtfully chosen. Just for you.</p>{% form 'customer', class: 'ga-form' %}{% if form.posted_successfully? %}<p role="status">Welcome to the house. You are on the list.</p>{% else %}{{ form.errors | default_errors }}<input type="hidden" name="contact[tags]" value="newsletter"><label for="ga-email">Email address</label><div class="ga-form-row"><input id="ga-email" name="contact[email]" type="email" autocomplete="email" placeholder="Your email address" required><button type="submit" aria-label="Join the House List">Join the house ↗</button></div><p class="ga-form-note">By subscribing, you agree to receive marketing emails. Unsubscribe anytime. <a href="{{ shop.privacy_policy.url }}">Privacy policy</a></p>{% endif %}{% endform %}</div></section>
  <div class="ga-cursor" aria-hidden="true"></div>
</div>
{% stylesheet %}
.ga{--g-ink:#142c23;--g-cream:#f3efe6;--g-gold:#b99a5c;background:var(--g-cream);color:var(--g-ink);font-family:Arial,sans-serif;padding-top:108px}.ga *{box-sizing:border-box}.ga a{color:inherit;text-decoration:none}.ga button{font:inherit;cursor:pointer}.ga h1,.ga h2,.ga h3,.ga p{margin:0}.ga h1,.ga h2,.ga h3,.ga-film-title{font-family:Georgia,'Times New Roman',serif;font-weight:400}.ga em{font-weight:400;color:#6b7865}.ga-wrap{width:90%;max-width:1440px;margin:auto}.ga-kicker{font-size:10px!important;letter-spacing:.2em;text-transform:uppercase;line-height:1.7!important}.ga-hero{display:grid;grid-template-columns:1fr 1fr;min-height:650px}.ga-hero-copy{display:flex;align-items:flex-start;justify-content:center;flex-direction:column;padding:72px 10% 32px}.ga h1{font-size:clamp(60px,6.5vw,108px);line-height:1.02;letter-spacing:-.055em;margin:28px 0}.ga-intro{font-size:14px;line-height:1.85;color:#5c675e}.ga-button{display:inline-flex;align-items:center;justify-content:space-between;gap:40px;background:var(--g-ink);color:var(--g-cream)!important;padding:19px 25px;border:1px solid var(--g-ink);border-radius:3px;font-size:10px;letter-spacing:.12em;text-transform:uppercase;transition:background .3s,transform .3s;margin-top:30px}.ga-button:hover{background:#30503d;transform:translateY(-3px)}.ga-hero-foot{margin-top:48px;display:flex;justify-content:space-between;gap:20px;width:100%;font-size:9px;letter-spacing:.08em;text-transform:uppercase;border-top:1px solid #142c2326;padding-top:20px}.ga-hero-film{position:relative;overflow:hidden;background:#0d2018;margin:18px 18px 18px 0;border-radius:160px 160px 14px 14px;min-height:600px}.ga-video{position:absolute;width:100%;height:100%;inset:0;object-fit:cover}.ga-hero-film:after{content:'';position:absolute;inset:0;background:linear-gradient(transparent,#07130e75);pointer-events:none}.ga-film-title{position:absolute;z-index:1;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;color:#d5b778;transform:translateY(var(--ga-drift,0px))}.ga-film-title img{object-fit:contain;margin-bottom:24px}.ga-film-title span{font-size:clamp(30px,4vw,66px);letter-spacing:.2em}.ga-film-title i{font-size:22px;color:#f3efe6;margin-top:15px}.ga-film-foot{position:absolute;bottom:25px;left:28px;right:28px;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:15px;color:#eee7d9;font-size:10px;letter-spacing:.04em}.ga-motion{border:1px solid #eee7d960;border-radius:30px;padding:9px 13px;color:inherit;background:#0d201866}.ga-selection{padding-block:100px}.ga-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:30px;margin-bottom:45px}.ga h2{font-size:clamp(36px,4.4vw,70px);line-height:1.12;letter-spacing:-.04em;margin-top:20px}.ga-link{display:inline-block;border-bottom:1px solid currentColor;padding-bottom:8px;font-size:10px;letter-spacing:.12em;text-transform:uppercase;transition:opacity .3s}.ga-link:hover{opacity:.65}.ga-products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:25px}.ga-product-image{aspect-ratio:4/5;background:#fff;position:relative;overflow:hidden;border-radius:14px}.ga-product-image img{height:100%;width:100%;object-fit:contain;transition:transform .8s cubic-bezier(.2,.7,.2,1)}.ga-product:hover img{transform:scale(1.045)}.ga-product-arrow{position:absolute;bottom:14px;right:14px;width:35px;height:35px;display:grid;place-items:center;border-radius:50%;background:var(--g-cream);transition:background .3s,color .3s}.ga-product:hover .ga-product-arrow{background:var(--g-ink);color:white}.ga-product>.ga-kicker{margin:20px 0 8px;color:#647060;font-size:9px!important}.ga-product-caption{display:flex;justify-content:space-between;gap:12px}.ga-product-caption h3{font-size:21px;line-height:1.25}.ga-product-caption>span{font-size:11px;white-space:nowrap;padding-top:5px}.ga-story{position:relative;overflow:hidden;text-align:center;padding:100px 0;background:#e8e8dd}.ga-story .ga-wrap{position:relative;z-index:1}.ga-story h2{font-size:clamp(40px,5vw,78px)}.ga-story .ga-wrap>p:not(.ga-kicker){max-width:480px;margin:25px auto;font-size:14px;line-height:1.9;color:#526054}.ga-orbit{position:absolute;width:600px;height:600px;border:1px solid #9b987536;border-radius:50%;left:-320px;top:-130px}.ga-cinema{height:115svh;background:var(--g-cream);padding-inline:3%;position:relative}.ga-cinema-scene{position:sticky;top:108px;height:85svh;min-height:540px;overflow:hidden;border-radius:28px;isolation:isolate;clip-path:inset(0 var(--ga-inset,0%) round 18px)}.ga-cinema-scene:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#07150dd9,#07150d22);z-index:0}.ga-cinema-copy{position:relative;z-index:1;color:#f3efe6;padding:14vh 7%;height:100%;display:flex;align-items:flex-start;justify-content:center;flex-direction:column}.ga-cinema-copy h2{font-size:clamp(40px,5.5vw,88px);margin-bottom:35px}.ga-cinema-copy em{color:#d5b778}.ga-cinema-index{position:absolute;z-index:1;bottom:32px;right:6%;font-size:9px;letter-spacing:.25em;color:#f3efe6}.ga-feature{display:grid;grid-template-columns:1fr 1fr;gap:9%;align-items:center;padding-block:100px}.ga-feature-image{display:block;position:relative;min-width:0;aspect-ratio:1;overflow:hidden;border-radius:28px;background:#ebe9e5;isolation:isolate;clip-path:inset(0 round 28px)}.ga-feature-image img{display:block;height:100%;width:100%;object-fit:contain;transform:scale(1);transition:transform 1.6s cubic-bezier(.16,1,.3,1)}.ga-feature-image:hover img{transform:scale(1.04)}.ga-feature h3{font-size:23px;margin:25px 0 15px}.ga-feature-copy>p:not(.ga-kicker){font-size:14px;color:#5c675e;line-height:1.9;max-width:340px}.ga-price{display:block;margin-top:20px;font-size:17px}.ga-join{text-align:center;background:#e5e6da;padding:90px 0}.ga-join>div>p:not(.ga-kicker){font-size:14px;line-height:1.8;color:#526054;margin-top:24px}.ga-form{max-width:530px;margin:35px auto 0;text-align:left}.ga-form label{font-size:11px}.ga-form-row{display:flex;border-bottom:1px solid #142c2360;margin-top:10px}.ga-form input{min-width:0;flex:1;padding:15px 0;background:transparent;border:0;color:var(--g-ink);font-size:14px}.ga-form button{border:0;background:transparent;color:var(--g-ink);font-size:10px;text-transform:uppercase;letter-spacing:.08em;padding:15px}.ga-form-note{font-size:10px!important;line-height:1.7;margin-top:15px!important;color:#526054}.ga-form-note a{text-decoration:underline}.ga a:focus-visible,.ga button:focus-visible,.ga input:focus-visible{outline:2px solid #a58544;outline-offset:5px}.ga-cursor{position:fixed;z-index:9999;left:0;top:0;width:28px;height:28px;border:1px solid #b99a5c;border-radius:50%;pointer-events:none;opacity:0;transition:width .2s,height .2s;mix-blend-mode:difference}.ga-cursor.is-active{opacity:1}.ga-motion-enabled .ga-reveal{transition:opacity .85s,transform .85s}.ga-motion-enabled .ga-reveal.ga-pending{opacity:0;transform:translateY(24px)}
.ga-motion-enabled .ga-feature-image{transition:clip-path 1.4s cubic-bezier(.16,1,.3,1),opacity 1s;transform:none}.ga-motion-enabled .ga-feature-image.ga-pending{transform:none;clip-path:inset(8% 5% round 36px)}.ga-motion-enabled .ga-feature-image.ga-pending img{transform:scale(1.12)}
@media(max-width:1000px){.ga-products{grid-template-columns:repeat(2,minmax(0,1fr))}.ga-hero-copy{padding:50px 8% 30px}.ga h1{font-size:65px}.ga-hero-film{min-height:540px;border-radius:120px 120px 14px 14px}.ga-hero-foot{font-size:8px;flex-wrap:wrap}}
@media(max-width:700px){.ga-hero{grid-template-columns:1fr;min-height:0}.ga-hero-copy{padding:45px 6% 30px}.ga h1{font-size:clamp(58px,13vw,82px);margin:20px 0}.ga-hero-foot{margin-top:30px}.ga-hero-film{margin:0 5% 25px;min-height:400px;border-radius:120px 120px 14px 14px}.ga-film-title span{font-size:45px}.ga-film-title img{width:80px;height:80px}.ga-heading{display:block}.ga-heading .ga-link{margin-top:25px}.ga-selection,.ga-feature{padding-block:65px}.ga-products{gap:30px 14px}.ga-product-caption{display:block}.ga-product-caption h3{font-size:20px;margin-bottom:10px}.ga-product-caption>span{font-size:12px}.ga-story{padding-block:65px}.ga-cinema{height:auto}.ga-cinema-scene{position:relative;top:0;height:620px;min-height:0;clip-path:none;border-radius:24px}.ga-cinema{padding:20px 5% 0}.ga-feature-image{border-radius:24px;clip-path:inset(0 round 24px)}.ga-cinema-copy{padding:60px 6%}.ga-feature{grid-template-columns:1fr;gap:35px}.ga-join{padding:65px 0}.ga-cursor{display:none}}
@media(prefers-reduced-motion:reduce){.ga *{animation:none!important;transition:none!important;scroll-behavior:auto!important}.ga-film-title{transform:none}.ga-cinema{height:auto}.ga-cinema-scene{position:relative;top:0;clip-path:none}.ga-motion-enabled .ga-feature-image.ga-pending{clip-path:inset(0 round 24px)}.ga-feature-image img{transform:none!important}.ga-cursor{display:none}.ga-motion-enabled .ga-reveal.ga-pending{opacity:1;transform:none}}
{% endstylesheet %}
{% javascript %}
(function(){
 function mount(root){
  if(!root||root.dataset.ready)return;root.dataset.ready='true';
  const reduced=matchMedia('(prefers-reduced-motion: reduce)'),videos=[...root.querySelectorAll('video')],button=root.querySelector('.ga-motion');let paused=reduced.matches,raf=0;
  const abort=new AbortController(),opts={signal:abort.signal};
  function playback(){videos.forEach(v=>{if(paused||document.hidden)v.pause();else v.play().catch(()=>{});});button.textContent=paused?'Play motion':'Pause motion';button.setAttribute('aria-pressed',String(paused));}
  button.addEventListener('click',()=>{paused=!paused;playback();},opts);document.addEventListener('visibilitychange',playback,opts);reduced.addEventListener('change',()=>{paused=reduced.matches;playback();},opts);playback();
  let observer;if(!reduced.matches&&'IntersectionObserver'in window){root.classList.add('ga-motion-enabled');observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.remove('ga-pending');observer.unobserve(e.target);}}),{threshold:.08});root.querySelectorAll('.ga-reveal').forEach(el=>{el.classList.add('ga-pending');observer.observe(el);});}
  const cinema=root.querySelector('.ga-cinema'),hero=root.querySelector('.ga-hero'),cursor=root.querySelector('.ga-cursor');
  function draw(){raf=0;if(reduced.matches)return;const rect=cinema.getBoundingClientRect();const p=Math.max(0,Math.min(1,(innerHeight-rect.top)/(innerHeight+rect.height)));root.style.setProperty('--ga-inset',(4*(1-p))+'%');root.style.setProperty('--ga-drift',Math.min(45,Math.max(0,-hero.getBoundingClientRect().top)*.1)+'px');}
  function scroll(){if(!raf)raf=requestAnimationFrame(draw);}window.addEventListener('scroll',scroll,{passive:true,signal:abort.signal});draw();
  root.addEventListener('pointermove',e=>{if(e.pointerType!=='mouse'||reduced.matches)return;cursor.classList.add('is-active');cursor.style.transform='translate('+(e.clientX-14)+'px,'+(e.clientY-14)+'px)';},opts);root.addEventListener('pointerleave',()=>cursor.classList.remove('is-active'),opts);
  document.addEventListener('shopify:section:unload',e=>{if(e.target.contains(root)){abort.abort();observer?.disconnect();cancelAnimationFrame(raf);}},opts);
 }
 document.querySelectorAll('[data-atelier]').forEach(mount);document.addEventListener('shopify:section:load',e=>mount(e.target.querySelector('[data-atelier]')));
})();
{% endjavascript %}
