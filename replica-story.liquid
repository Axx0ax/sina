{% javascript %}
(function(){function mount(root){if(!root||root.dataset.ready)return;root.dataset.ready='true';const reduced=matchMedia('(prefers-reduced-motion: reduce)'),videos=[...root.querySelectorAll('video')],motion=root.querySelector('.gs-motion'),hero=root.querySelector('.gs-hero'),crest=root.querySelector('.gs-crest'),film=root.querySelector('.gs-film'),cursor=root.querySelector('.gs-cursor');let paused=reduced.matches,raf=0;const abort=new AbortController(),opts={signal:abort.signal};function playback(){root.classList.toggle('gs-still',paused);videos.forEach(v=>{if(paused||document.hidden)v.pause();else v.play().catch(()=>{});});motion.textContent=paused?'Play motion':'Pause motion';motion.setAttribute('aria-pressed',String(paused));}motion.addEventListener('click',()=>{paused=!paused;playback();},opts);reduced.addEventListener('change',()=>{paused=reduced.matches;playback();},opts);document.addEventListener('visibilitychange',playback,opts);playback();let observer;if('IntersectionObserver'in window&&!reduced.matches){root.classList.add('gs-enhanced');observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.remove('gs-wait');observer.unobserve(e.target);}}),{threshold:.1});root.querySelectorAll('.gs-reveal').forEach(el=>{el.classList.add('gs-wait');observer.observe(el);});}const clamp=n=>Math.min(1,Math.max(0,n));function draw(){raf=0;const box=root.getBoundingClientRect();root.style.setProperty('--gs-progress',clamp(-box.top/Math.max(1,box.height-innerHeight)));if(paused)return;const h=hero.getBoundingClientRect(),c=crest.getBoundingClientRect(),f=film.getBoundingClientRect(),cp=clamp((innerHeight-c.top)/(innerHeight+c.height)),fp=clamp((innerHeight-f.top)/(innerHeight+f.height));root.style.setProperty('--gs-hero-drift',Math.min(60,Math.max(0,-h.top)*.12)+'px');root.style.setProperty('--gs-copy-drift',Math.min(35,Math.max(0,-h.top)*.07)+'px');root.style.setProperty('--gs-crest-turn',(-7+cp*14)+'deg');root.style.setProperty('--gs-crest-scale',.92+cp*.16);root.style.setProperty('--gs-ring-turn',cp*140+'deg');root.style.setProperty('--gs-film-inset',(4*(1-fp))+'%');root.style.setProperty('--gs-film-scale',1.12-fp*.12);}function scroll(){if(!raf)raf=requestAnimationFrame(draw);}window.addEventListener('scroll',scroll,{passive:true,signal:abort.signal});window.addEventListener('resize',scroll,opts);draw();root.addEventListener('pointermove',e=>{if(e.pointerType!=='mouse'||paused)return;cursor.classList.add('gs-visible');cursor.style.transform='translate('+(e.clientX-15)+'px,'+(e.clientY-15)+'px)';},opts);root.addEventListener('pointerleave',()=>cursor.classList.remove('gs-visible'),opts);document.addEventListener('shopify:section:unload',e=>{if(e.target.contains(root)){abort.abort();observer?.disconnect();cancelAnimationFrame(raf);}},opts);}document.querySelectorAll('[data-story-cinema]').forEach(mount);document.addEventListener('shopify:section:load',e=>mount(e.target.querySelector('[data-story-cinema]')));})();
{% endjavascript %}
