cky;top:120px;height:calc(85svh - 100px);min-height:480px;border-radius:30px;overflow:hidden;isolation:isolate;clip-path:inset(0 var(--gs-film-inset,3%) round 30px);background:#17382a}.gs-film-frame:after{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,#082015ba,#08201520)}.gs-film video{transform:scale(var(--gs-film-scale,1.1))}.gs-film-copy{height:100%;display:flex;flex-direction:column;justify-content:center;padding:60px 7%;color:var(--cream)}.gs-film-copy h2{font-size:clamp(60px,7vw,108px);margin:20px 0}.gs-film-copy em{color:#dcc68e}.gs-film-copy>p:last-child{font:13px Arial,sans-serif;color:#e0decf}.gs-film-index{position:absolute;bottom:24px;right:30px;font:8px Arial,sans-serif;letter-spacing:.2em;color:#dcc68e}.gs-principles{padding-block:110px}.gs-principle-list{margin-top:55px}.gs-principle-list article{display:grid;grid-template-columns:60px 1fr 35px;gap:25px;border-top:1px solid #17382a30;padding:32px 0;align-items:start}.gs-principle-list article>span{font:12px Georgia,serif;color:#9f885d;padding-top:12px}.gs-principle-list article>span:last-child{font-size:25px;transition:transform .4s}.gs-principle-list article:hover>span:last-child{transform:translate(4px,-4px)}.gs-principle-list h3{font-size:38px}.gs-principle-list p{font:14px/1.9 Arial,sans-serif;color:#65715d;max-width:560px;margin-top:15px}.gs-finale{padding:90px 6%;text-align:center;background:#e4e6d9}.gs-finale h2{font-size:clamp(64px,8vw,120px)}.gs-button{display:inline-flex;align-items:center;gap:50px;background:#17382a;color:var(--cream)!important;border-radius:40px;padding:20px 28px;margin-top:35px;font:10px Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase;transition:background .3s,transform .3s}.gs-button:hover{background:#31553e;transform:translateY(-3px)}.gs-news{max-width:500px;margin:80px auto 0;padding-top:40px;border-top:1px solid #17382a30}.gs-news h3{font-size:30px}.gs-news>p{font:13px/1.8 Arial,sans-serif;margin:15px 0 25px;color:#62715d}.gs-form{text-align:left}.gs-form label{font:10px Arial,sans-serif}.gs-form>div{display:flex;border-bottom:1px solid #17382a66}.gs-form input{padding:16px 0;min-width:0;flex:1;background:none;border:0;color:#17382a;font:13px Arial,sans-serif}.gs-form button{background:none;border:0;padding:15px;color:#17382a;font:10px Arial,sans-serif;text-transform:uppercase;white-space:nowrap}.gs-form .gs-consent{font:10px/1.7 Arial,sans-serif;color:#687361;margin-top:15px}.gs-consent a{text-decoration:underline}.gs a:focus-visible,.gs button:focus-visible,.gs input:focus-visible{outline:2px solid #ac8d52;outline-offset:5px}.gs-progress{height:2px;position:fixed;top:108px;left:0;right:0;transform:scaleX(var(--gs-progress,0));transform-origin:left;background:#c8ad76;z-index:21;pointer-events:none}.gs-enhanced .gs-reveal{transition:opacity 1s,transform 1.15s cubic-bezier(.16,1,.3,1)}.gs-enhanced .gs-wait{opacity:0;transform:translateY(35px)}.gs-cursor{position:fixed;left:0;top:0;width:30px;height:30px;border:1px solid #d7c18c;border-radius:50%;pointer-events:none;z-index:999;opacity:0;mix-blend-mode:difference}.gs-cursor.gs-visible{opacity:1}.gs-still .gs-wait{opacity:1;transform:none}.gs-still .gs-hero video,.gs-still .gs-hero-copy,.gs-still .gs-crest-art img,.gs-still .gs-ring,.gs-still .gs-film video{transform:none}.gs-still .gs-film-frame{clip-path:none}
