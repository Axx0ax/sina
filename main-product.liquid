<div class="pa"><nav class="pa-breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">GORONY</a><span>/</span><a href="{{ routes.all_products_collection_url }}">THE COLLECTION</a><span>/</span><span>{{ product.title | escape }}</span></nav>
<div class="g-pdp">
  <div class="g-pdp__media">
    {%- assign first_image = product.selected_or_first_available_variant.featured_image | default: product.featured_image -%}
    {%- if first_image -%}
      <img data-main-image src="{{ first_image | image_url: width: 900 }}" alt="{{ product.title | escape }}" width="900" height="1200">
    {%- else -%}
      <div style="aspect-ratio:3/4;background:var(--green-3);border:1px solid rgba(139,111,62,0.4);"></div>
    {%- endif -%}

    {%- assign image_count = 0 -%}
    {%- for media in product.media -%}{%- if media.media_type == 'image' -%}{%- assign image_count = image_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- if image_count > 1 -%}
      <div class="g-pdp__thumbs">
        {%- assign thumbnail_index = 0 -%}
        {%- for media in product.media -%}
          {%- if media.media_type == 'image' -%}
            {%- assign thumbnail_index = thumbnail_index | plus: 1 -%}
            <button
              type="button"
              class="g-pdp__thumb{% if first_image and media.id == first_image.id %} g-pdp__thumb--active{% endif %}"
              data-thumb
              data-full="{{ media | image_url: width: 900 }}"
              aria-label="View {{ product.title | escape }} image {{ thumbnail_index }}"
              aria-pressed="{% if first_image and media.id == first_image.id %}true{% else %}false{% endif %}">
              <img src="{{ media | image_url: width: 160 }}" alt="" width="160" height="213" loading="lazy">
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- for media in product.media -%}
      {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
        {{ media | media_tag: image_size: '900x', autoplay: true, loop: true, muted: true, controls: false, style: 'width:100%;margin-top:16px;border:1px solid rgba(139,111,62,0.4);' }}
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="g-pdp__info">
    {%- if product.type != blank -%}<p class="g-card__cat" style="margin-top:0;">{{ product.type }}</p>{%- endif -%}
    <h1 class="g-pdp__title">{{ product.title }}</h1>
    <p class="g-pdp__price" data-price aria-live="polite" aria-atomic="true">{{ product.selected_or_first_available_variant.price | money }}</p>
    {%- form 'product', product, id: 'gProductForm' -%}
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <div class="g-pdp__option" data-option-group data-option-index="{{ forloop.index0 }}">
            <p class="g-pdp__option-label">{{ option.name }}: <span data-option-chosen>{{ option.selected_value }}</span></p>
            <div class="g-swatches">
              {%- for value in option.values -%}
                <button type="button" class="g-swatch{% if option.selected_value == value %} g-swatch--active{% endif %}" data-swatch data-value="{{ value | escape }}" aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}">{{ value }}</button>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endunless -%}
      <input type="hidden" name="id" data-variant-id value="{{ product.selected_or_first_available_variant.id }}">
      <button type="submit" data-add-btn class="g-btn-solid" style="width:100%;margin-top:24px;" aria-live="polite" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
        {%- if product.selected_or_first_available_variant.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
      </button>
    {%- endform -%}
    <div id="gAddedNote" style="display:none;margin-top:16px;border:1px solid rgba(201,162,75,0.5);background:rgba(201,162,75,0.06);padding:14px 16px;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
      <span style="font-size:13px;letter-spacing:0.05em;color:var(--ivory);">Added to your bag.</span>
      <span style="display:flex;gap:14px;align-items:center;">
        <a href="{{ routes.cart_url }}" style="color:var(--gold);letter-spacing:0.15em;text-transform:uppercase;font-size:12px;">View Bag</a>
        <a href="{{ routes.cart_url }}/checkout" style="color:var(--green);background:var(--gold);padding:9px 16px;letter-spacing:0.15em;text-transform:uppercase;font-size:12px;">Checkout</a>
      </span>
    </div>
    <p id="gAddedError" style="display:none;margin-top:12px;color:#e6b8b8;font-size:13px;" role="alert"></p>

    {%- comment -%} shipping / returns / security, where the decision is made {%- endcomment -%}
    <ul class="g-pdp__trust" style="list-style:none;margin:26px 0 0;padding:20px 0 0;border-top:1px solid rgba(139,111,62,0.3);display:grid;gap:11px;">
      <li style="display:flex;gap:10px;align-items:flex-start;font-size:13px;color:rgba(245,240,230,0.72);"><span aria-hidden="true" style="color:var(--gold);">&#10022;</span> Dispatched within 1&ndash;3 business days, tracked</li>
      <li style="display:flex;gap:10px;align-items:flex-start;font-size:13px;color:rgba(245,240,230,0.72);"><span aria-hidden="true" style="color:var(--gold);">&#10022;</span> 30-day returns on unopened items</li>
      <li style="display:flex;gap:10px;align-items:flex-start;font-size:13px;color:rgba(245,240,230,0.72);"><span aria-hidden="true" style="color:var(--gold);">&#10022;</span> Secure checkout &middot; every message answered by the family</li>
    </ul>

    {%- comment -%}
      Belt-and-braces: the CSV import removes the leaked "Description" heading
      from the product data itself; these guards catch the plain variants in
      case one is ever pasted back in. Only Liquid-native filters here.
    {%- endcomment -%}
    {%- assign pdp_body = product.description
          | remove_first: '<h2>Description</h2>'
          | remove_first: '<h3>Description</h3>'
          | remove_first: '<h2><span>Description</span></h2>'
          | remove_first: '<h3><span>Description</span></h3>'
          | remove_first: '<h2><strong>Description</strong></h2>'
          | remove_first: '<h3><strong>Description</strong></h3>' -%}
    <div class="g-pdp__desc g-rte" style="margin-top:40px;border-top:1px solid rgba(139,111,62,0.3);padding-top:24px;">{{ pdp_body }}</div>
  </div>
</div>

<script>
  (function () {
    var variants = [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id | json }},
          "options": {{ variant.options | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | json }},
          "image": {%- if variant.featured_image -%}{{ variant.featured_image | image_url: width: 900 | json }}{%- else -%}null{%- endif -%}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ];
    var optionNames = [
      {%- for option in product.options_with_values -%}
        {{ option.name | json }}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ];
    var productImages = [
      {%- assign image_index = 0 -%}
      {%- for media in product.media -%}
        {%- if media.media_type == 'image' -%}
          {%- assign image_index = image_index | plus: 1 -%}
          {
            "src": {{ media | image_url: width: 900 | json }},
            "alt": {{ media.alt | default: '' | json }}
          }{%- unless image_index == image_count -%},{%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    ];
    var form = document.getElementById('gProductForm');
    if (!form) return;
    var groups = form.querySelectorAll('[data-option-group]');
    var idInput = form.querySelector('[data-variant-id]');
    var btn = form.querySelector('[data-add-btn]');
    var priceEl = document.querySelector('[data-price]');
    var mainImg = document.querySelector('[data-main-image]');

    function money(cents) {
      if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
        return window.Shopify.formatMoney(cents, {{ shop.money_format | json }});
      }
      return '$' + (cents / 100).toFixed(2);
    }

    function normalize(value) {
      return (value || '').toString().toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
    }

    function compact(value) {
      return normalize(value).replace(/\s+/g, '');
    }

    function absoluteUrl(url) {
      if (!url) return '';
      try {
        return new URL(url, window.location.href).href;
      } catch (e) {
        return url;
      }
    }

    function chosenValues() {
      return Array.prototype.map.call(groups, function (g) {
        var active = g.querySelector('.g-swatch--active');
        return active ? active.getAttribute('data-value') : null;
      });
    }

    function matchingImageForChoice(chosen) {
      var colorIndex = optionNames.findIndex(function (name) {
        var normalized = normalize(name);
        return normalized.indexOf('color') !== -1 || normalized.indexOf('colour') !== -1 || normalized.indexOf('shade') !== -1;
      });
      if (colorIndex === -1) return null;

      var selectedColor = chosen[colorIndex];
      var selected = normalize(selectedColor);
      var selectedCompact = compact(selectedColor);
      if (!selected) return null;

      return productImages.find(function (image) {
        var haystack = normalize(image.alt + ' ' + image.src);
        var haystackCompact = compact(image.alt + ' ' + image.src);
        return haystack.indexOf(selected) !== -1 || haystackCompact.indexOf(selectedCompact) !== -1;
      });
    }

    function setActiveThumb(src) {
      var current = absoluteUrl(src);
      document.querySelectorAll('[data-thumb]').forEach(function (thumb) {
        var isActive = absoluteUrl(thumb.getAttribute('data-full')) === current;
        thumb.classList.toggle('g-pdp__thumb--active', isActive);
        thumb.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
    }

    function setMainImage(src) {
      if (!mainImg || !src) return;
      if (absoluteUrl(mainImg.getAttribute('src')) === absoluteUrl(src)) {
        setActiveThumb(src);
        return;
      }

      mainImg.style.opacity = '0';
      window.setTimeout(function () {
        mainImg.src = src;
        mainImg.removeAttribute('srcset');
        mainImg.style.opacity = '1';
        setActiveThumb(src);
      }, 120);
    }

    function update() {
      var chosen = chosenValues();
      var match = variants.find(function (v) {
        return v.options.every(function (opt, i) { return opt === chosen[i]; });
      });
      if (!match) {
        if (btn) {
          btn.disabled = true;
          btn.textContent = 'Unavailable';
        }
        return;
      }
      idInput.value = match.id;
      if (priceEl) priceEl.textContent = money(match.price);
      if (match.available) { btn.disabled = false; btn.textContent = 'Add to Cart'; }
      else { btn.disabled = true; btn.textContent = 'Sold Out'; }

      var fallbackImage = matchingImageForChoice(chosen);
      setMainImage(match.image || (fallbackImage && fallbackImage.src));

      if (window.history && window.history.replaceState) {
        var url = new URL(window.location.href);
        url.searchParams.set('variant', match.id);
        window.history.replaceState({}, '', url.toString());
      }
    }

    Array.prototype.forEach.call(groups, function (g) {
      var label = g.querySelector('[data-option-chosen]');
      g.addEventListener('click', function (e) {
        var swatch = e.target.closest('[data-swatch]');
        if (!swatch) return;
        g.querySelectorAll('.g-swatch').forEach(function (s) {
          s.classList.remove('g-swatch--active');
          s.setAttribute('aria-pressed', 'false');
        });
        swatch.classList.add('g-swatch--active');
        swatch.setAttribute('aria-pressed', 'true');
        if (label) label.textContent = swatch.getAttribute('data-value');
        update();
      });
    });

    document.querySelectorAll('[data-thumb]').forEach(function (t) {
      t.addEventListener('click', function () {
        setMainImage(t.getAttribute('data-full'));
      });
    });

    if (groups.length) update();
    else if (mainImg) setActiveThumb(mainImg.getAttribute('src'));
  })();
</script>

<script>
  (function () {
    var form = document.getElementById('gProductForm');
    if (!form) return;
    var btn = form.querySelector('[data-add-btn]');
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!btn || btn.disabled) return;
      var original = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Adding...';
      fetch('/cart/add.js', { method: 'POST', body: new FormData(form), headers: { 'Accept': 'application/json' } })
        .then(function (r) {
          if (!r.ok) return r.json().then(function (d) { throw new Error(d.description || d.message || 'Could not add to bag.'); });
          return r.json();
        })
        .then(function () { return fetch('/cart.js', { headers: { 'Accept': 'application/json' } }).then(function (r) { return r.json(); }); })
        .then(function (cart) {
          document.querySelectorAll('[data-cart-count]').forEach(function (el) { el.textContent = cart.item_count; });
          var note = document.getElementById('gAddedNote');
          if (note) note.style.display = 'flex';
          btn.textContent = 'Added';
          window.setTimeout(function () { btn.disabled = false; btn.textContent = original; }, 1500);
        })
        .catch(function (err) {
          var errEl = document.getElementById('gAddedError');
          if (errEl) { errEl.textContent = err.message; errEl.style.display = 'block'; window.setTimeout(function () { errEl.style.display = 'none'; }, 5000); }
          btn.disabled = false;
          btn.textContent = original;
        });
    });
  })();
</script>
