{% javascript %}
(()=>{const root=document.querySelector('.pa');if(!root)return;const reduced=matchMedia('(prefers-reduced-motion: reduce)'),media=root.querySelector('.g-pdp__media'),main=root.querySelector('[data-main-image]'),dialog=root.querySelector('.pa-zoom'),body=root.querySelector('.g-pdp__desc');if(main&&media&&dialog){const zoom=document.createElement('button');zoom.type='button';zoom.className='pa-zoom-button';zoom.textContent='A closer look +';media.append(zoom);zoom.addEventListener('click',()=>{const img=dialog.querySelector('img');img.src=main.currentSrc||main.src;img.alt=main.alt;dialog.showModal()});dialog.querySelector('button').addEventListener('click',()=>dialog.close());dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});}if(body){const nodes=[...body.childNodes];let panel;nodes.forEach(node=>{if(node.nodeType===1&&/^H[23]$/.test(node.tagName)){const detail=document.createElement('details');detail.className='pa-detail';const summary=document.createElement('summary');summary.textContent=node.textContent;panel=document.createElement('div');detail.append(summary,panel);body.insertBefore(detail,node);node.remove();detail.addEventListener('toggle',()=>{if(detail.open&&!reduced.matches)detail.lastElementChild.animate([{opacity:0,transform:'translateY(7px)'},{opacity:1,transform:'none'}],{duration:350,easing:'ease-out'})});}else if(panel)panel.append(node);});}if(!reduced.matches){const cursor=document.createElement('div');cursor.className='pa-cursor';cursor.setAttribute('aria-hidden','true');root.append(cursor);root.addEventListener('pointermove',e=>{if(e.pointerType!=='mouse')return;cursor.style.opacity='1';cursor.style.transform='translate('+(e.clientX-15)+'px,'+(e.clientY-15)+'px)'});root.addEventListener('pointerleave',()=>cursor.style.opacity='0');if(main)main.animate([{opacity:0,transform:'scale(.96)'},{opacity:1,transform:'scale(1)'}],{duration:1000,easing:'cubic-bezier(.2,.7,.2,1)'});if('IntersectionObserver'in window){const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.remove('pa-wait');observer.unobserve(e.target)}}));const closing=root.querySelector('.pa-closing');closing.classList.add('pa-wait');observer.observe(closing);}}})();
{% endjavascript %}

