erflow:hidden;opacity:.6;transition:opacity .3s,border-color .3s}.pa .g-pdp__thumb img{width:100%;height:100%;object-fit:contain;border-radius:9px}.pa .g-pdp__thumb--active,.pa .g-pdp__thumb:hover{opacity:1;border-color:#897244!important}.pa .g-pdp__option-label{font:11px Arial,sans-serif!important;letter-spacing:.04em;color:#62705d!important}.pa .g-pdp__option-label span{color:var(--pa-ink)!important}.pa .g-swatches{display:flex;flex-wrap:wrap;gap:8px}.pa .g-swatch{background:transparent!important;color:var(--pa-ink)!important;border:1px solid #173b2c33!important;border-radius:25px!important;padding:12px 16px!important;font:11px Arial,sans-serif!important;min-height:42px;transition:background .3s,transform .3s}.pa .g-swatch--active{background:#183b2c!important;color:#f2eee5!important;border-color:#183b2c!important}.pa .g-swatch:hover{transform:translateY(-2px)}.pa [data-add-btn]{background:#183b2c!important;color:#f2eee5!important;border:1px solid #183b2c!important;border-radius:50px!important;min-height:59px;font:11px Arial,sans-serif!important;letter-spacing:.14em!important;transition:background .3s,transform .3s,box-shadow .3s!important}.pa [data-add-btn]:hover:not(:disabled){background:#345540!important;transform:translateY(-2px);box-shadow:0 12px 30px #173b2c18}.pa [data-add-btn]:disabled{opacity:.55}.pa #gAddedNote{border-radius:14px;background:#e4e8d9!important;border-color:#b3bea4!important}.pa #gAddedNote span,.pa #gAddedNote a{color:#183b2c!important}.pa #gAddedError{color:#972f26!important}.pa .g-pdp__trust{border-color:#183b2c22!important;padding-top:22px!important;gap:12px!important}.pa .g-pdp__trust li{color:#697661!important;font-size:11px!important;line-height:1.6}.pa .g-pdp__desc{border-color:#183b2c22!important;color:#62705d!important;font:14px/1.95 Arial,sans-serif!important;margin-top:30px!important;overflow-wrap:anywhere}.pa .g-pdp__desc p,.pa .g-pdp__desc li{color:#62705d!important;font:13px/1.95 Arial,sans-serif!important}.pa .g-pdp__desc h2,.pa .g-pdp__desc h3{color:#183b2c!important;font:28px Georgia,serif!important}.pa .g-pdp__desc a{color:#183b2c!important}.pa .pa-detail{border-bottom:1px solid #183b2c22;padding:0}.pa .pa-detail summary{list-style:none;display:flex;align-items:center;justify-content:space-between;padding:22px 0;font:23px Georgia,serif;color:#183b2c;cursor:pointer}.pa .pa-detail summary::-webkit-details-marker{display:none}.pa .pa-detail summary:after{content:'+';font:21px Arial,sans-serif;color:#8a754b}.pa .pa-detail[open] summary:after{content:'−'}.pa .pa-detail>div{padding-bottom:22px}.pa .pa-detail ul{padding-left:18px}.pa-zoom-button{display:block;margin:12px 0 0 auto;background:transparent;border:0;border-bottom:1px solid #183b2c44;padding:9px 0;color:#66735f;font:9px Arial,sans-serif;letter-spacing:.13em;text-transform:uppercase;cursor:pointer}.pa-closing{margin:0 -6.82%;padding:75px 7%;background:#e3e7d9;text-align:center;border-radius:35px 35px 0 0}.pa-closing p{font:9px Arial,sans-serif;letter-spacing:.19em;color:#897448}.pa-closing h2{font:400 clamp(37px,5vw,68px)/1.1 Georgia,serif;letter-spacing:-.04em;color:#183b2c;margin:25px 0}.pa-closing em{color:#7d8c70}.pa-closing a{color:#183b2c;font:10px Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;border-bottom:1px solid #183b2c44;padding-bottom:12px;display:inline-block}.pa-zoom{max-width:95vw;width:900px;height:90svh;max-height:90svh;border:0;border-radius:24px;padding:55px 20px 20px;background:#f5f2ea}.pa-zoom::backdrop{background:#081d16d9;backdrop-filter:blur(7px)}.pa-zoom img{width:100%;height:100%;object-fit:contain}.pa-close{position:absolute;right:22px;top:18px;border:0;background:transparent;color:#183b2c;font:12px Arial,sans-serif;cursor:pointer;padding:8px}.pa :focus-visible{outline:2px solid #ad8c48;outline-offset:5px}.pa-cursor{position:fixed;left:0;top:0;width:30px;height:30px;border:1px solid #a58b5799;border-radius:50%;pointer-events:none;z-index:9999;opacity:0}.pa-cursor:af